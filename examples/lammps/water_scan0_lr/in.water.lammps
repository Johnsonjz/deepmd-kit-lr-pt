# water-scan0 2L DPA4-SOG canonical .pt2, one frame, no dynamics.
# Pass the data/model/plugin through -var; no dataset path is committed.
# DATA/MODEL/PLUGIN come from -var on the LAMMPS command line.
plugin load ${PLUGIN}
units metal
boundary p p p
atom_style charge
atom_modify map yes
read_data ${DATA}
mass 1 15.999
mass 2 1.008
pair_style deepmd ${MODEL}
pair_coeff * * O H
thermo 1
thermo_style custom step pe press
run 0
