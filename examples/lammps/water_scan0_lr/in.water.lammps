# water-scan0 2L DPA4-SOG canonical .pt2, one frame, no dynamics.
# Pass the data/model/plugin through -var; no dataset path is committed.
variable DATA  index ${WATER_SCAN0_LMP_DATA}
variable MODEL index ${WATER_SCAN0_MODEL}
variable PLUGIN index ${WATER_SCAN0_PLUGIN}

plugin load ${PLUGIN}
units metal
boundary p p p
atom_style charge
atom_modify map yes
read_data ${DATA}
mass 1 15.999
mass 2 1.008
pair_style deepmd ${MODEL}
pair_coeff * * O H
thermo 1
thermo_style custom step pe press
run 0
